direction: down

users: 利用者 {class: users}

aws: AWS Cloud {
  class: aws-cloud

  edge: "" {
    class: plain
    grid-columns: 3
    route53: Route 53 {class: route-53}
    waf: WAF {class: waf}
    e1: {class: spacer}
    e2: {class: spacer}
    cloudfront: CloudFront {class: cloudfront}
    e3: {class: spacer}
  }

  region: ap-northeast-1 {
    class: region

    storage: "" {
      class: plain
      grid-columns: 3
      s1: {class: spacer}
      s2: {class: spacer}
      s3: S3 {class: s3}
    }

    vpc: VPC {
      class: vpc
      alb: ALB {class: alb}

      azs: "" {
        class: plain
        grid-columns: 3

        az_a: ap-northeast-1a {
          class: az
          app: プライベートサブネット {
            class: private-subnet
            node: ノード {
              class: k8s-node
              pod: Pod {class: k8s-pod}
            }
          }
          db: DB サブネット {
            class: private-subnet
            aurora: "Aurora\nリーダー" {class: aurora-instance}
          }
        }
        az_c: ap-northeast-1c {
          class: az
          app: プライベートサブネット {
            class: private-subnet
            node: ノード {
              class: k8s-node
              pod: Pod {class: k8s-pod}
            }
          }
          db: DB サブネット {
            class: private-subnet
            aurora: "Aurora\nライター" {class: aurora-instance}
          }
        }
        az_d: ap-northeast-1d {
          class: az
          app: プライベートサブネット {
            class: private-subnet
            node: ノード {
              class: k8s-node
              pod: Pod {class: k8s-pod}
            }
          }
          db: DB サブネット {
            class: private-subnet
            aurora: "Aurora\nリーダー" {class: aurora-instance}
          }
        }
      }
    }
  }
}

users -> aws.edge.route53: 名前解決 {class: from-left}
users -> aws.edge.waf: HTTPS
aws.edge.waf -> aws.edge.cloudfront
aws.edge.cloudfront -> aws.region.storage.s3: 静的ファイル {class: from-right}
aws.edge.cloudfront -> aws.region.vpc.alb: API

aws.region.vpc.alb -> aws.region.vpc.azs.az_a.app.node.pod
aws.region.vpc.alb -> aws.region.vpc.azs.az_c.app.node.pod
aws.region.vpc.alb -> aws.region.vpc.azs.az_d.app.node.pod

aws.region.vpc.azs.az_a.app.node.pod -> aws.region.vpc.azs.az_c.db.aurora: SQL
aws.region.vpc.azs.az_c.app.node.pod -> aws.region.vpc.azs.az_c.db.aurora: SQL
aws.region.vpc.azs.az_d.app.node.pod -> aws.region.vpc.azs.az_c.db.aurora: SQL
aws.region.vpc.azs.az_c.db.aurora -> aws.region.vpc.azs.az_a.db.aurora: 複製 {class: async}
aws.region.vpc.azs.az_c.db.aurora -> aws.region.vpc.azs.az_d.db.aurora: 複製 {class: async}

